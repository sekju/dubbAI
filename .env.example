# Google Gemini
GEMINI_API_KEY=twoj_klucz_api_z_google_ai_studio
GEMINI_MODEL_TEXT=gemini-2.5-flash-lite
GEMINI_MODEL_TTS=gemini-2.5-flash-preview-tts

# Async tasks
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Storage
UPLOAD_DIRECTORY=./storage/uploads
OUTPUT_DIRECTORY=./storage/outputs
MAX_VIDEO_SIZE_MB=500

# App URLs
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3002

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/dubbai

# Security
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_REFRESH_SECRET_KEY=replace-with-a-second-long-random-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Cloudflare R2
R2_ENDPOINT_URL=https://twoje-konto.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=twoj_access_key_id
R2_SECRET_ACCESS_KEY=twoj_secret_access_key
R2_BUCKET_NAME=dubbai
R2_PUBLIC_BASE_URL=
R2_REGION=auto

# SMTP / activation mails
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM_EMAIL=noreply@dubbai.local

# Frontend public vars
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
